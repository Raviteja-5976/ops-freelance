# OpenRiverStack Client Portal — environment template
#
# Local development : copy to .env.local and fill in.
# AWS Amplify       : set each of these in the Amplify console under
#                     App settings → Environment variables. Do NOT commit
#                     real values; .env.local is gitignored.
#
# `npm run check-env` validates the required ones.

# ─── Supabase (required) ──────────────────────────────────────────────────────
# Settings → API in the Supabase dashboard.
# The two NEXT_PUBLIC_ values are inlined into the browser bundle at BUILD time,
# so they must be present when Amplify builds, not just at runtime.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — bypasses row-level security. Never expose to the browser.
# Used to settle payments, issue invoices, and create invited accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App URL (required) ───────────────────────────────────────────────────────
# Used for links in outgoing email and for auth redirect targets.
# No trailing slash. On Amplify set this to your live domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Transactional email (SMTP) ───────────────────────────────────────────────
# Sends invoices, payment receipts, workspace invites, sign-up confirmations and
# password resets. Without these the app still runs and logs emails instead of
# sending them.
#
# The app deliberately does NOT use Supabase's built-in mailer, which caps auth
# email at a handful per hour.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=founder@openriverstack.com
SMTP_PASSWORD=your_smtp_password_here
EMAIL_FROM="OpenRiverStack <no-reply@openriverstack.com>"
EMAIL_REPLY_TO=support@openriverstack.com

# Where payment alerts and call requests are sent.
FOUNDER_EMAIL=founder@openriverstack.com
INFO_EMAIL=info@openriverstack.com

# ─── Payments (Razorpay) ──────────────────────────────────────────────────────
# Without these the Pay button is disabled; stages can still be verified by hand
# in the admin portal.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Set the same value in the Razorpay dashboard when creating the webhook that
# points at https://<your-domain>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
